DAYTONA_API_KEY=
# Nosana job URL, e.g. https://<id>.node.k8s.prd.nos.ci/v1  (any OpenAI-compatible URL works while it boots)
NOSANA_BASE_URL=
NOSANA_API_KEY=
NOSANA_TEXT_MODEL=qwen2.5-coder:7b
# Optional: only if a vision model is served
NOSANA_VISION_MODEL=
# Optional Neo4j trip ledger
NEO4J_URI=
NEO4J_USER=   # AuraDB: often the instance id, not "neo4j" (see the downloaded credentials file)
NEO4J_PASSWORD=
